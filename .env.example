# CyberSentinel monorepo — canonical environment contract (Phase 1 freeze)
# Copy values into backend/.env and frontend/.env (Vite only reads VITE_* from frontend/).
# Never commit real secrets.

# ── Runtime mode ───────────────────────────────────────────
# development | production
ENVIRONMENT=development

# ── MongoDB (required for staging/prod; recommended locally) ─
# Canonical name: MONGODB_URI (not MONGODB_URL)
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=cybersentinel
# mongodb | memory (memory = AIS-style smoke only; prod must be mongodb)
STORAGE_BACKEND=mongodb

# ── Auth (Phase 2+) ─────────────────────────────────────────
# ≥32 random chars. Production refuses weak defaults.
JWT_SECRET=change-me-in-production-min-32-chars-long-please
JWT_EXPIRE_HOURS=24

# Transitional machine/dev key (Threat Explainer today).
# Production refuses: empty, dev-key, changeme, secret, password, api-key
API_KEY=dev-key

# ── CORS / URLs ─────────────────────────────────────────────
# Comma-separated. Add staging/prod frontend origins explicitly — never * in prod.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# ── Redis (optional; fail-open if down) ─────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── Gemini explainability ───────────────────────────────────
# Code reads GEMINI_API_KEYS (plural).
GEMINI_API_KEYS=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
USE_MOCK_AGENTS=false

# ── Optional enrichers / hybrid ML ──────────────────────────
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
PHISHSTATS_API_URL=https://phishstats.info/api
SAFEPROMPT_API_KEY=
HIVE_AI_API_KEY=
NVIDIA_API_KEY=
# Leave empty for Gemini-only
HF_API_URL=

# ── Billing (Phase 5 — leave empty until then) ──────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
# development only — never true in staging/production
ALLOW_DEV_BILLING=true

# Optional OpenAI proxy
# OPENAI_API_KEY=

# ── Frontend (Vite — set in frontend/.env) ──────────────────
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000/api/ws/threats
# VITE_API_KEY=dev-key
# VITE_USE_MOCKS=false
