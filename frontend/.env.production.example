# Copy these into Vercel Project → Settings → Environment Variables
# (or rename to .env.production before `npm run build` locally).
#
# VITE_* vars are baked in at BUILD time — set them before building.

# Your live Render backend URL (no trailing slash)
VITE_API_URL=https://your-backend.onrender.com

# Must match backend API_KEY on Render
VITE_API_KEY=replace-with-your-strong-api-key

# Always false in production
VITE_USE_MOCKS=false
