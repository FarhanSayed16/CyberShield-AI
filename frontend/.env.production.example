# Copy these into Vercel Project → Settings → Environment Variables
# (or rename to .env.production before `npm run build` locally).
#
# VITE_* vars are baked in at BUILD time — set them before building.

VITE_API_URL=https://your-backend.onrender.com
VITE_WS_URL=wss://your-backend.onrender.com/api/ws/threats

# Prefer JWT login — leave unset for normal dashboard use.
# Only set if a machine client still needs X-API-Key against the backend.
# VITE_API_KEY=

VITE_USE_MOCKS=false
