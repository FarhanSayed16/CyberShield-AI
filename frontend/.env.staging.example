# Staging frontend — set in Vercel Preview/Staging env BEFORE build
# VITE_* are compile-time.

VITE_API_URL=https://your-backend-staging.onrender.com
VITE_WS_URL=wss://your-backend-staging.onrender.com/api/ws/threats
VITE_USE_MOCKS=false

# Prefer JWT console — leave unset unless a machine client still needs it
# VITE_API_KEY=
