# === MongoDB (Atlas for production) ===
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/cybersentinel?retryWrites=true&w=majority
DB_NAME=cybersentinel

# === Gemini (comma-separated if you have multiple keys) ===
# Code reads GEMINI_API_KEYS (plural). Do NOT use GEMINI_API_KEY.
GEMINI_API_KEYS=your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
USE_MOCK_AGENTS=false

# === External enrichers (optional) ===
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
PHISHSTATS_API_URL=https://phishstats.info/api
SAFEPROMPT_API_KEY=
HIVE_AI_API_KEY=
NVIDIA_API_KEY=

# === Hugging Face ML Space (after you deploy cybersentinel-ml-api) ===
# Leave empty for Gemini-only (default free deploy). When set, health.pipeline_mode becomes "hybrid".
# Example: https://YOUR-HF-USERNAME-cybersentinel-engine.hf.space
HF_API_URL=

# === Security ===
# development | production
# In production, API_KEY must NOT be a weak default (dev-key, empty, etc.) or the app refuses to start.
ENVIRONMENT=development
# Local default is fine for development only. On Render/production, set a long random secret.
API_KEY=dev-key

# Comma-separated origins. Local + production frontend.
# After Vercel deploy, add: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173
