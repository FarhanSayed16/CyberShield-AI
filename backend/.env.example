# === MongoDB ===
# Canonical: MONGODB_URI (see repo-root .env.example)
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=cybersentinel
# mongodb | memory (memory reserved for AIS smoke until Phase 2 unifies)
STORAGE_BACKEND=mongodb

# === Auth (Phase 2 wires JWT; set strong secret now) ===
JWT_SECRET=change-me-in-production-min-32-chars-long-please
JWT_EXPIRE_HOURS=24

# === Gemini (comma-separated if you have multiple keys) ===
# Code reads GEMINI_API_KEYS (plural). Do NOT use GEMINI_API_KEY.
GEMINI_API_KEYS=your-gemini-api-key
# Optional: comma-separated keys rotate automatically if the first key is invalid
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash-lite
USE_MOCK_AGENTS=false

# === External enrichers (optional) ===
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
PHISHSTATS_API_URL=https://phishstats.info/api
SAFEPROMPT_API_KEY=
HIVE_AI_API_KEY=
NVIDIA_API_KEY=

# === Hugging Face ML Space (optional) ===
# Leave empty for Gemini-only (default free deploy).
HF_API_URL=

# === Redis (optional; fail-open) ===
REDIS_URL=redis://127.0.0.1:6379/0

# === Security ===
# development | production
# In production: weak API_KEY and weak JWT_SECRET are refused.
ENVIRONMENT=development
# Local default is fine for development only.
API_KEY=dev-key

# Comma-separated origins. After Vercel deploy, add production URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# === Stripe (Phase 5) ===
# Leave empty for local: set ALLOW_DEV_BILLING=true and POST /api/billing/dev-activate as admin.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
ALLOW_DEV_BILLING=true

# Optional OpenAI proxy (Growth) — leave empty unless using /proxy
# OPENAI_API_KEY=
