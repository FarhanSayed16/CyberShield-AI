# Staging / production-like backend env
# Copy to backend/.env.staging (do not commit secrets) and use with:
#   docker compose -f docker-compose.yml -f docker-compose.staging.yml --env-file backend/.env.staging up --build
# Or point Render env vars at these names.

# production | staging — both refuse weak API_KEY / JWT_SECRET
ENVIRONMENT=staging

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_32PLUS_CHAR_RANDOM_SECRET_xxxxxxxx
JWT_EXPIRE_HOURS=24

# Generate another random string — never use dev-key in staging
API_KEY=REPLACE_WITH_STRONG_MACHINE_API_KEY

MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net
DB_NAME=cybersentinel_staging
STORAGE_BACKEND=mongodb

# Staging frontend origin(s) only — no wildcard
CORS_ORIGINS=https://your-app-staging.vercel.app
FRONTEND_URL=https://your-app-staging.vercel.app

REDIS_URL=redis://redis:6379/0

GEMINI_API_KEYS=your-gemini-key
USE_MOCK_AGENTS=false
HF_API_URL=

# Stripe TEST mode — webhook secret required in staging
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
ALLOW_DEV_BILLING=false
